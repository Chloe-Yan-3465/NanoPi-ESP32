[Unit]
Description=NanoPi Mode2 camera and UART acquisition (autostart v2)
Wants=dev-ttyS1.device
After=local-fs.target dev-ttyS1.device
StartLimitIntervalSec=0

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi
Environment=HOME=/home/pi
Environment=TIME_SET_MODE=idle
ExecStartPre=+/usr/local/sbin/nanopi-recover-realsense-v2
ExecStart=/home/pi/start_tmux_autostart_v2.sh
SuccessExitStatus=143
Restart=on-failure
RestartSec=20
TimeoutStopSec=40
KillMode=mixed
CapabilityBoundingSet=CAP_SYS_TIME CAP_SYS_NICE
AmbientCapabilities=CAP_SYS_TIME CAP_SYS_NICE
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
